# -----------------------------------------------------------------------------
# The Lily Put Birthday Experience — environment
#
# Copy to `.env.local` only if you want to override these defaults locally.
# The website content lives in src/lib/content/local-seed.ts.
# -----------------------------------------------------------------------------

# Canonical site URL — used for absolute links, QR codes and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Developer convenience ----------------------------------------------------
# Set to "1" to land straight in the main experience while editing, skipping the
# intro/candle/gift opening. Leave unset for the real thing Lily sees.
NEXT_PUBLIC_SKIP_OPENING=""
